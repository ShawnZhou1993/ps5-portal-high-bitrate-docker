# ============ 必改：局域网参数（对应你的实际网络）============

# 中继主机上连接 PS5/Portal 所在局域网的有线网卡（或网桥）。
# 查看命令：ip -br addr
#   飞牛NAS(X86)：多为 bond0（多网口聚合）或 enp2s0/enp3s0 等
#   OpenWrt 软路由(R68S)：br-lan
# 注意：Wi-Fi 接口不能作为 macvlan 父接口
LAN_PARENT=eth0

# 你的局域网网段和网关（按路由器实际填写）
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# 分配给中继容器的 IP：必须在路由器 DHCP 池之外（或在 DHCP 里做保留）
RELAY_IP=192.168.1.215

# ============ 注册时使用（configure-env 子命令读取）============

# PS5 的 IPv4（建议在路由器里做 DHCP 保留，防止 IP 变化）
PS5_IP=192.168.1.60
# Portal 的 IPv4（同样建议 DHCP 保留）
PORTAL_IP=192.168.1.50
# 码率档位：65 / 100 / 200（200 为实验性；建议先用 65 验证流程）
PROFILE=65
# 容器内网卡名：macvlan 容器内固定为 eth0，一般不用改
IFACE=eth0
